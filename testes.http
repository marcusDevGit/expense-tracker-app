###

### Registrar Novo Usuário
POST http://localhost:3333/api/users/register HTTP/1.1
content-type: application/json

{
  "name": "Marcus Phellypp",
  "email": "{{email}}",
  "password": "senha123456"
}

###

### Login
POST http://localhost:3333/api/auth/login HTTP/1.1
content-type: application/json

{
  "email": "{{email}}",
"password": "senha123456"
}

###

### Logout
POST http://localhost:3333/api/auth/logout HTTP/1.1
content-type: application/json

{
  "email": "marcus@example2.com"
}

###

### Forgot Password
POST http://localhost:3333/api/auth/forgot-password HTTP/1.1
content-type: application/json

{
  "email": "marcus@example2.com"
}

###

### Reset Password
POST http://localhost:3333/api/auth/reset-password HTTP/1.1
content-type: application/json

{
  "token": "<token>",
  "password": "[PASSWORD]"
}

###
### Listar Wallets
# Substitua SEU_TOKEN_AQUI pelo token obtido no login
GET http://localhost:3333/api/wallets HTTP/1.1
Authorization: Bearer {{token}}

###
### Criar Wallet
# Substitua SEU_TOKEN_AQUI pelo token obtido no login
POST http://localhost:3333/api/wallets HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Carteira Principal de teste de delete",
  "currency": "BRL",
  "initialBalance": 1000.00
}

###
### Buscar Wallet por ID
# Substitua SEU_TOKEN_AQUI pelo token do login
# Substitua SEU_WALLET_ID_AQUI pelo ID da wallet criada
GET http://localhost:3333/api/wallets/fa13cab2-ae73-423c-a11a-0b410c5399e5 HTTP/1.1
Authorization: Bearer {{token}}
### Atualizar Wallet
# Substitua SEU_TOKEN_AQUI pelo token do login
# Substitua SEU_WALLET_ID_AQUI pelo ID da wallet
PUT http://localhost:3333/api/wallets/fa13cab2-ae73-423c-a11a-0b410c5399e5 HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Carteira Atualizada",
  "currency": "USD"
}

###
### Deletar Wallet
# Substitua SEU_TOKEN_AQUI pelo token do login
# Substitua SEU_WALLET_ID_AQUI pelo ID da wallet
DELETE http://localhost:3333/api/wallets/cd55cd47-853d-4f72-84d3-ca7cb88870f8 HTTP/1.1
Authorization: Bearer {{token}}

###
### Wallet Dashboard
# Substitua SEU_TOKEN_AQUI pelo token do login
# Substitua SEU_WALLET_ID_AQUI pelo ID da wallet criada
GET http://localhost:3333/api/wallets/fa13cab2-ae73-423c-a11a-0b410c5399e5/dashboard?month=1&year=2026 HTTP/1.1
Authorization: Bearer {{token}}
