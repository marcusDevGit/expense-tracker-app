{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",

    "typeRoots": ["./node_modules/@types", "src/@types"],

    "lib": [
      "ES2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ]
  },
  "include": ["src/**/*", "prisma/seed.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist", "generated"]
}
